// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  CLIENTE // Obsoleto: migrado a MASTER. Se conserva porque Postgres no permite quitar valores de un enum.
  PSICOLOGO // Obsoleto: migrado a PROFESIONAL.
  ADMIN // Administrador de la plataforma. Solo accede al panel de control.
  PROFESIONAL
  ASISTENTE
  SOPORTE // Obsoleto: sus funciones pasaron a ADMIN.
  PACIENTE // Paciente de un cliente
  MASTER // Titular de la cuenta del consultorio. Uno por tenant (índice parcial User_tenantId_master_key).
}

enum TenantType {
  PERSONAL // Psicólogo individual
  CLINIC // Clínica con múltiples psicólogos
}

enum PlanType {
  TRIAL // Trial 14 días (personal o clínica)
  PERSONAL_BASIC // Psicólogo individual - básico
  PERSONAL_PRO // Psicólogo individual - profesional
  CLINIC_BASIC // Clínica - básico (cupo limitado)
  CLINIC_PRO // Clínica - profesional (más cupo y módulos)
  CLINIC_ENTERPRISE // Clínica - enterprise (custom)
}

enum SubscriptionStatus {
  TRIALING // In trial period
  ACTIVE // Paid and active
  PAST_DUE // Payment failed, grace period
  CANCELED // Canceled but still in billing period
  INCOMPLETE // Payment setup incomplete
  UNPAID // Grace period expired
}

enum SubscriptionPaymentKind {
  PLAN_UPGRADE // Charge that activates a higher plan once it is confirmed
  RENEWAL // Charge for the next billing period of the current plan
}

enum SubscriptionPaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELED // Replaced by a newer request of the tenant
  EXPIRED // Never confirmed in time
}

enum SubscriptionEventType {
  TRIAL_STARTED
  TRIAL_ENDED
  PLAN_UPGRADED
  PLAN_DOWNGRADED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_REACTIVATED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  SEATS_INCREASED
  SEATS_DECREASED
  FEATURE_ENABLED
  FEATURE_DISABLED
  LIMIT_REACHED
  GRACE_PERIOD_ENTERED
  GRACE_PERIOD_ENDED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  APPOINTMENT_REMINDER
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  TASK_ASSIGNED
  TASK_DUE_SOON
  SYSTEM_ANNOUNCEMENT
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
}

enum AuditEntity {
  CLINICAL_NOTE
  SPECIALTY_RECORD
  ENCOUNTER
  PATIENT_FILE
  PATIENT
  APPOINTMENT
  USER
  TENANT
  TREATMENT_SESSION
  CONSENT_DOCUMENT
  BILLING_PROFILE
  ORDER
  PAYMENT
  CASH_REGISTER
  INVOICE_REQUEST
}

enum EncounterType {
  FIRST_VISIT
  FOLLOW_UP
  CONTROL
  EMERGENCY
  TELECONSULTATION
  HOME_VISIT
  PROCEDURE
  ASSESSMENT
  INTERCONSULTATION
}

enum EncounterStatus {
  OPEN
  CLOSED
}

enum InvoiceStatus {
  PENDING
  ISSUED
  FAILED
  VOIDED
}

enum InvoiceDocumentType {
  INVOICE
  CREDIT_NOTE
}

enum ConsentTemplateVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ConsentDocumentStatus {
  PRESENTED
  SIGNED
  REFUSED
  REVOKED
}

enum ConsentEventType {
  PRESENTED
  SIGNED
  REFUSED
  REVOKED
}

enum ConsentSignerRole {
  PATIENT
  REPRESENTATIVE
}

enum TreatmentSessionStatus {
  INTAKE_IN_PROGRESS
  READY_FOR_CONSENT
  CONSENTED
  IN_PROGRESS
  CLINICAL_COMPLETE
  CONSENT_REFUSED
  CONSENT_REVOKED
  CANCELLED
  NO_SHOW
  BILLING_PENDING
  BILLED
  BILLING_FAILED
}

// Where in the procedure a session photo was taken.
enum SessionMediaPhase {
  BEFORE
  AFTER
  OTHER
}

// ============================================
// TENANT & SUBSCRIPTION
// ============================================

model Tenant {
  invoicingConnection InvoicingConnection?
  invoiceRequests     InvoiceRequest[]

  id                      String     @id @default(cuid())
  name                    String
  email                   String
  phone                   String?
  address                 String?
  logoUrl                 String?
  tenantType              TenantType @default(PERSONAL)
  isActive                Boolean    @default(true)
  onboardingCompleted     Boolean    @default(false)
  isPlatform              Boolean    @default(false)
  legalName               String?
  taxIdentificationType   String? // RUC, CEDULA or PASSPORT
  taxIdentificationNumber String?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  // Relations
  settings                TenantSettings?
  billingSettings         BillingSettings?
  subscription            TenantSubscription?
  subscriptionPayments    SubscriptionPayment[]
  users                   User[]
  patients                Patient[]
  patientProfessionals    PatientProfessional[]
  specialtyRecords        SpecialtyRecord[]
  appointments            Appointment[]
  clinicalNotes           ClinicalNote[]
  tasks                   Task[]
  nextSessionPlans        NextSessionPlan[]
  notifications           NotificationLog[]
  auditLogs               AuditLog[]
  usageMetrics            UsageMetrics[]
  subscriptionEvents      SubscriptionEvent[]
  invoices                Invoice[]
  specialties             TenantSpecialty[]
  enabledModules          TenantModule[]
  formDefinitions         FormDefinition[]
  branches                Branch[]
  encounters              Encounter[]
  medications             Medication[]
  documentTemplates       DocumentTemplate[]
  userPermissions         UserPermission[]
  rolePermissions         TenantRolePermission[]
  patientFiles            PatientFile[]
  professionalBranches    ProfessionalBranch[]
  treatments              Treatment[]
  treatmentVersions       TreatmentVersion[]
  consentTemplates        ConsentTemplate[]
  consentTemplateVersions ConsentTemplateVersion[]
  consentDocuments        ConsentDocument[]
  consentSignatures       ConsentSignature[]
  consentEvents           ConsentEvent[]
  treatmentSessions       TreatmentSession[]
  billingProfiles         BillingProfile[]
  patientBillingProfiles  PatientBillingProfile[]
  cashRegisterSessions    CashRegisterSession[]
  orders                  Order[]
  orderItems              OrderItem[]
  payments                Payment[]

  @@index([isActive])
}

// A physical location of the clinic. Every clinic has one main branch.
model Branch {
  emissionPoint BranchEmissionPoint?

  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name         String
  address      String?
  city         String?
  phone        String?
  openingHours String?
  // Consulting rooms of the branch, by name.
  rooms        String[] @default([])
  isMain       Boolean  @default(false)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments         Appointment[]
  encounters           Encounter[]
  professionals        ProfessionalBranch[]
  treatmentSessions    TreatmentSession[]
  cashRegisterSessions CashRegisterSession[]
  orders               Order[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

// Where a professional attends. A professional without rows attends in every branch.
model ProfessionalBranch {
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, branchId])
  @@index([branchId])
  @@index([tenantId])
}

model BillingSettings {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider           String   @default("FAKTUR")
  apiKey             String?
  establishment      String?
  emissionPoint      String?
  nextSequential     Int      @default(1)
  businessName       String?
  businessAddress    String?
  specialTaxpayer    Boolean  @default(false)
  accountingRequired Boolean  @default(false)
  withholdingAgent   Boolean  @default(false)
  isEnabled          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId, isEnabled])
}

model Invoice {
  id             String              @id @default(cuid())
  tenantId       String
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   TenantSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  issuerId       String
  issuer         User                @relation("IssuedInvoices", fields: [issuerId], references: [id], onDelete: Restrict)
  patientId      String?
  patient        Patient?            @relation(fields: [patientId], references: [id], onDelete: SetNull)

  documentType        InvoiceDocumentType @default(INVOICE)
  status              InvoiceStatus       @default(PENDING)
  issueDate           DateTime            @default(now())
  currency            String              @default("USD")
  subtotal            Decimal             @db.Decimal(10, 2)
  tax                 Decimal             @default(0) @db.Decimal(10, 2)
  total               Decimal             @db.Decimal(10, 2)
  customerName        String
  customerEmail       String
  customerTaxIdType   String
  customerTaxId       String
  customerAddress     String?
  description         String
  externalId          String?
  accessKey           String?
  authorizationNumber String?
  xmlUrl              String?
  pdfUrl              String?
  errorMessage        String?
  providerResponse    Json?
  idempotencyKey      String              @unique
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([tenantId, createdAt])
  @@index([status])
  @@index([externalId])
  @@index([tenantId, issuerId, createdAt])
  @@index([tenantId, patientId, createdAt])
}

model TenantSettings {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Working hours
  workingHoursStart String   @default("09:00") // HH:mm format
  workingHoursEnd   String   @default("18:00")
  workingDays       String[] @default(["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY"])

  // Appointment settings
  defaultAppointmentDuration Int     @default(60) // minutes
  allowDoubleBooking         Boolean @default(false)

  // Reminder settings
  reminderRules   String[] @default(["24h", "2h"]) // e.g., ["24h", "2h", "30m"]
  reminderEnabled Boolean  @default(true)

  // Locale & timezone
  timezone String @default("America/Mexico_City")
  locale   String @default("es-MX")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantSubscription {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Plan & Status
  planType PlanType           @default(TRIAL)
  status   SubscriptionStatus @default(TRIALING)

  // Billing cycle
  startDate          DateTime  @default(now())
  endDate            DateTime?
  trialEndsAt        DateTime?
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?
  cancelAt           DateTime? // Scheduled cancellation

  // Pricing
  basePrice    Decimal @default(0) @db.Decimal(10, 2)
  pricePerSeat Decimal @default(0) @db.Decimal(10, 2)
  currency     String  @default("USD")

  // Seats
  seatsPsychologistsMax  Int @default(1)
  seatsPsychologistsUsed Int @default(0)

  // Resource Limits
  maxActivePatients              Int     @default(10)
  storageGB                      Int     @default(0) // 0 = unlimited
  monthlyNotificationsLimit      Int     @default(100)
  includedSpecialties            Int     @default(1)
  specialtyPrice                 Decimal @default(15) @db.Decimal(10, 2)
  monthlyElectronicInvoicesLimit Int     @default(50)

  // Feature Flags (boolean)
  featureClinicalNotes           Boolean @default(true)
  featureClinicalNotesEncryption Boolean @default(false)
  featureAttachments             Boolean @default(false)
  featureTasks                   Boolean @default(false)
  featurePsychologicalTests      Boolean @default(false)
  featureWebPush                 Boolean @default(false)
  featureFCMPush                 Boolean @default(false)
  featureAdvancedAnalytics       Boolean @default(false)
  featureVideoConsultation       Boolean @default(false)
  featureCalendarSync            Boolean @default(false)
  featureOnlineSchedulingWidget  Boolean @default(false)
  featureCustomReports           Boolean @default(false)
  featureAPIAccess               Boolean @default(false)
  featureWhatsAppIntegration     Boolean @default(false)
  featureSSO                     Boolean @default(false)

  // Usage Tracking (updated in real-time)
  activePatientsCount           Int      @default(0)
  storageUsedBytes              BigInt   @default(0)
  monthlyNotificationsSent      Int      @default(0)
  lastNotificationReset         DateTime @default(now())
  monthlyElectronicInvoicesUsed Int      @default(0)
  lastInvoiceReset              DateTime @default(now())

  // Scheduled changes
  scheduledPlanChange   PlanType?
  scheduledPlanChangeAt DateTime?

  // Payment integration
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  stripePaymentMethodId String?

  specialties SubscriptionSpecialty[]
  invoices    Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
}

// A charge the tenant owes. Nothing paid is enabled until its payment is CONFIRMED.
model SubscriptionPayment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  kind   SubscriptionPaymentKind
  status SubscriptionPaymentStatus @default(PENDING)

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("USD")

  // PLAN_UPGRADE: the plan to activate. RENEWAL: the plan being renewed.
  targetPlan  PlanType
  // RENEWAL: the billing period this payment covers.
  periodStart DateTime?
  periodEnd   DateTime?

  // Who collected the money and under which reference. MANUAL = confirmed by support.
  provider          String  @default("MANUAL")
  providerReference String?

  requestedById  String?
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  expiresAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The same provider event can never confirm two payments.
  @@unique([provider, providerReference])
  // One renewal per tenant and period, however many times the scheduler runs.
  @@unique([tenantId, kind, periodStart])
  @@index([tenantId, status])
  @@index([status, expiresAt])
}

model UsageMetrics {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Snapshot date
  recordedAt  DateTime @default(now())
  periodStart DateTime
  periodEnd   DateTime

  // Usage data
  seatsPsychologistsUsed Int
  activePatientsCount    Int
  storageUsedGB          Decimal @db.Decimal(10, 2)
  notificationsSent      Int
  appointmentsCreated    Int
  clinicalNotesCreated   Int
  tasksCreated           Int

  // Costs (for internal tracking)
  estimatedCost Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([tenantId, recordedAt])
  @@index([periodStart, periodEnd])
}

model SubscriptionEvent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  eventType      SubscriptionEventType
  previousPlan   PlanType?
  newPlan        PlanType?
  previousStatus SubscriptionStatus?
  newStatus      SubscriptionStatus?

  // Details
  reason   String?
  metadata Json?

  // Who triggered (null for system events)
  triggeredByUserId String?
  triggeredByUser   User?   @relation(fields: [triggeredByUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([eventType])
}

// ============================================
// USERS & AUTH
// ============================================

model User {
  requestedInvoices InvoiceRequest[]

  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email             String
  password          String
  firstName         String
  lastName          String
  phone             String?
  avatarUrl         String?
  professionalTitle String?
  licenseNumber     String?

  role               UserRole
  isActive           Boolean  @default(true)
  emailVerified      Boolean  @default(false)
  mustChangePassword Boolean  @default(false)

  // Provider-managed access (for PSYCHOLOGIST role in CLINIC tenants)
  // When true, only the system provider (OWNER) can grant/revoke access
  managedByProvider Boolean @default(false)

  // Push notifications
  fcmToken String? // Firebase Cloud Messaging token

  // Invite flow
  invitedAt      DateTime?
  invitedBy      String? // userId who sent the invite
  activatedAt    DateTime?
  lastActivityAt DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  refreshTokens            RefreshToken[]
  assignedAppointments     Appointment[]           @relation("LegacyAppointmentPsychologist")
  professionalAppointments Appointment[]           @relation("AppointmentProfessional")
  patientAssignments       PatientProfessional[]   @relation("PatientTeamProfessional")
  patientAssignmentsMade   PatientProfessional[]   @relation("PatientTeamAssigner")
  assignedPatients         Patient[]               @relation("AssignedPatients")
  clinicalNotes            ClinicalNote[]
  tasksCreated             Task[]                  @relation("TaskCreator")
  tasksAssigned            Task[]                  @relation("TaskAssignee")
  nextSessionPlans         NextSessionPlan[]
  notifications            NotificationLog[]
  notificationPreference   NotificationPreference?
  pushSubscriptions        PushSubscription[]
  auditLogs                AuditLog[]
  subscriptionEvents       SubscriptionEvent[]
  professionalSpecialties  ProfessionalSpecialty[]
  professionalProfile      ProfessionalProfile?
  specialtyRecords         SpecialtyRecord[]
  encounters               Encounter[]
  permissionOverrides      UserPermission[]        @relation("UserPermissionOverrides")
  branchAssignments        ProfessionalBranch[]
  uploadedFiles            PatientFile[]
  issuedInvoices           Invoice[]               @relation("IssuedInvoices")
  treatmentSessions        TreatmentSession[]
  consentEvents            ConsentEvent[]
  createdBillingProfiles   BillingProfile[]        @relation("BillingProfileCreatedBy")
  openedCashRegisters      CashRegisterSession[]   @relation("CashRegisterOpenedBy")
  closedCashRegisters      CashRegisterSession[]   @relation("CashRegisterClosedBy")
  createdOrders            Order[]                 @relation("OrderCreatedBy")
  cancelledOrders          Order[]                 @relation("OrderCancelledBy")
  createdOrderItems        OrderItem[]             @relation("OrderItemCreatedBy")
  receivedPayments         Payment[]               @relation("PaymentReceivedBy")
  refundedPayments         Payment[]               @relation("PaymentRefundedBy")
  consentSignaturesTaken   ConsentSignature[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@index([role])
}

model RefreshToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique
  familyId  String // for token rotation tracking
  isRevoked Boolean  @default(false)
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([familyId])
}

// ============================================
// PATIENTS
// ============================================

model Patient {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  dateOfBirth           DateTime?
  gender                String?
  address               String?
  emergencyContact      String?
  emergencyPhone        String?
  emergencyContactName  String?
  emergencyContactPhone String?

  // Identification. Unique per tenant among live patients (partial index
  // Patient_tenantId_identification_key, created in the migration).
  identificationType   String? // CEDULA, RUC, PASSPORT or OTHER
  identificationNumber String?

  maritalStatus String?
  occupation    String?
  nationality   String?
  bloodType     String?
  disability    String?

  insuranceProvider     String?
  insurancePolicyNumber String?

  // Legal guardian; required when the patient is a minor.
  guardianName           String?
  guardianRelationship   String?
  guardianIdentification String?
  guardianPhone          String?

  // Assigned psychologist
  assignedPsychologistId String?
  assignedPsychologist   User?   @relation("AssignedPatients", fields: [assignedPsychologistId], references: [id], onDelete: SetNull)

  // Medical info (basic)
  allergies         String?
  currentMedication String?
  notes             String? // General notes (not clinical)

  // Billing recipient for this patient's invoices. May be the patient or a third party.
  billingName      String?
  billingTaxIdType String? // RUC, CEDULA or PASSPORT
  billingTaxId     String?
  billingEmail     String?
  billingAddress   String?

  isActive  Boolean   @default(true)
  deletedAt DateTime? // Soft delete

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  appointments            Appointment[]
  clinicalNotes           ClinicalNote[]
  tasks                   Task[]
  nextSessionPlans        NextSessionPlan[]
  specialtyRecords        SpecialtyRecord[]
  professionalAssignments PatientProfessional[]
  invoices                Invoice[]
  encounters              Encounter[]
  files                   PatientFile[]
  treatmentSessions       TreatmentSession[]
  billingProfiles         PatientBillingProfile[]
  orderItems              OrderItem[]
  consentDocuments        ConsentDocument[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([lastName])
  @@index([tenantId, identificationNumber])
}

model PatientProfessional {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professionalId String
  professional   User     @relation("PatientTeamProfessional", fields: [professionalId], references: [id], onDelete: Restrict)
  assignedAt     DateTime @default(now())
  assignedById   String?
  assignedBy     User?    @relation("PatientTeamAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([patientId, professionalId])
  @@index([tenantId, patientId, isActive])
  @@index([tenantId, professionalId, isActive])
}

// ============================================
// SPECIALTIES & MODULAR FEATURES
// ============================================

model Specialty {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenants                 TenantSpecialty[]
  professionals           ProfessionalSpecialty[]
  professionalProfiles    ProfessionalProfile[]
  modules                 SpecialtyModule[]
  planMappings            PlanSpecialty[]
  appointments            Appointment[]
  clinicalNotes           ClinicalNote[]
  sessionPlans            NextSessionPlan[]
  subscriptionSpecialties SubscriptionSpecialty[]
  records                 SpecialtyRecord[]
  formDefinitions         FormDefinition[]
  encounters              Encounter[]
  treatments              Treatment[]
}

model SpecialtyRecord {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId        String
  patient          Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professionalId   String
  professional     User            @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  specialtyId      String
  specialty        Specialty       @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  appointmentId    String?
  appointment      Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  // The encounter the record was written in, when the professional opened one.
  encounterId      String?
  encounter        Encounter?      @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  moduleKey        String
  // The version of the module or form definition the data was validated against.
  schemaVersion    Int             @default(1)
  // Printed on the document and encoded in its QR, so that a third party can check it is
  // authentic without reading its content.
  verificationCode String?         @unique
  // Set for answers to a form defined by the tenant (moduleKey `custom.<formDefinitionId>`).
  formDefinitionId String?
  formDefinition   FormDefinition? @relation(fields: [formDefinitionId], references: [id], onDelete: Restrict)
  recordDate       DateTime        @default(now())
  data             Json
  notes            String?

  // Clinical records are never removed physically: corrections bump the version, removals set deletedAt.
  version        Int       @default(1)
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  treatmentSession TreatmentSession?

  @@index([tenantId, patientId, recordDate])
  @@index([tenantId, specialtyId, moduleKey])
  @@index([appointmentId])
  @@index([formDefinitionId])
  @@index([encounterId])
}

// One attention of a patient by a professional. It groups the records written during it.
model Encounter {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professionalId String
  professional   User         @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  specialtyId    String
  specialty      Specialty    @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  // An appointment is attended in at most one encounter.
  appointmentId  String?      @unique
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  encounterType EncounterType
  status        EncounterStatus @default(OPEN)

  // Stored encrypted.
  reason  String
  summary String?

  startedAt DateTime  @default(now())
  // Closing is the professional's sign-off: no record is added afterwards.
  closedAt  DateTime?

  version        Int       @default(1)
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records          SpecialtyRecord[]
  notes            ClinicalNote[]
  files            PatientFile[]
  treatmentSession TreatmentSession?

  @@index([tenantId, patientId, startedAt])
  @@index([tenantId, professionalId, status])
}

// A clinical file of a patient: a lab result, an image, a signed consent. The bytes live in
// the file storage under `storageKey`, encrypted like the rest of the clinical content.
model PatientFile {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  patientId    String
  patient      Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User       @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  encounterId  String?
  encounter    Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  category    String
  // Stored encrypted: a file name or a description can say what the patient has.
  fileName    String
  description String?

  mimeType   String
  sizeBytes  Int
  storageKey String @unique

  // Set for photos taken during a treatment session; null for every other file.
  treatmentSessionId String?
  treatmentSession   TreatmentSession?  @relation(fields: [treatmentSessionId], references: [id], onDelete: SetNull)
  phase              SessionMediaPhase?

  // Clinical files are never removed physically: removal sets deletedAt.
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?

  createdAt DateTime @default(now())

  @@index([tenantId, patientId, createdAt])
  @@index([encounterId])
  @@index([treatmentSessionId])
}

// Diagnosis classification shared by every clinic (CIE-10, CIE-11).
model DiagnosisCode {
  id          String  @id @default(cuid())
  system      String
  code        String
  description String
  isActive    Boolean @default(true)

  @@unique([system, code])
  @@index([description])
}

// Medication catalog of a clinic, offered when prescribing.
model Medication {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  commercialName     String
  activeIngredient   String?
  concentration      String?
  presentation       String?
  pharmaceuticalForm String?
  isActive           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, isActive, commercialName])
}

/// Text a clinic reuses in its certificates and consents. `{{paciente}}`-style variables are
/// filled in by the client when the template is applied to a record.
model DocumentTemplate {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // The clinical module whose records it prefills, e.g. general.certificates.
  moduleKey String
  name      String
  title     String?
  body      String
  isActive  Boolean @default(true)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, moduleKey, name])
  @@index([tenantId, moduleKey, isActive])
}

// A permission granted to or withdrawn from one user, over what the role gives by default.
model UserPermission {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation("UserPermissionOverrides", fields: [userId], references: [id], onDelete: Cascade)

  permission String
  granted    Boolean

  createdById String?
  createdAt   DateTime @default(now())

  @@unique([userId, permission])
  @@index([tenantId])
}

// Platform-managed overrides shared by every user with this role in one clinic.
model TenantRolePermission {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role        UserRole
  permission  String
  granted     Boolean
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([tenantId, role, permission])
  @@index([tenantId])
}

// A clinical form designed by the tenant. Its content lives in immutable versions:
// editing a form adds a version, and every answer keeps the version it was filled with.
model FormDefinition {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String?
  category    String?
  // Null: any professional of the tenant can fill it. Set: only that specialty.
  specialtyId String?
  specialty   Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)

  isActive       Boolean @default(true)
  currentVersion Int     @default(1)
  createdById    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions          FormDefinitionVersion[]
  records           SpecialtyRecord[]
  treatmentVersions TreatmentVersion[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model FormDefinitionVersion {
  id               String         @id @default(cuid())
  formDefinitionId String
  formDefinition   FormDefinition @relation(fields: [formDefinitionId], references: [id], onDelete: Cascade)

  version     Int
  schema      Json
  createdById String
  createdAt   DateTime @default(now())

  @@unique([formDefinitionId, version])
}

model TenantSpecialty {
  tenantId    String
  specialtyId String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([tenantId, specialtyId])
  @@index([specialtyId])
}

model ProfessionalSpecialty {
  userId      String
  specialtyId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  isPrimary   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@id([userId, specialtyId])
  @@index([specialtyId])
}

model ProfessionalProfile {
  userId            String    @id
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialtyId       String
  specialty         Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  professionalTitle String?
  licenseNumber     String?
  bio               String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([specialtyId, isActive])
}

model SpecialtyModule {
  id          String    @id @default(cuid())
  specialtyId String
  moduleKey   String
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([specialtyId, moduleKey])
  @@index([moduleKey])
}

model PlanSpecialty {
  id          String    @id @default(cuid())
  planType    PlanType
  specialtyId String
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([planType, specialtyId])
  @@index([specialtyId])
}

model SubscriptionSpecialty {
  tenantSubscriptionId String
  specialtyId          String
  tenantSubscription   TenantSubscription @relation(fields: [tenantSubscriptionId], references: [id], onDelete: Cascade)
  specialty            Specialty          @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())

  @@id([tenantSubscriptionId, specialtyId])
  @@index([specialtyId])
}

model TenantModule {
  id        String   @id @default(cuid())
  tenantId  String
  moduleKey String
  enabled   Boolean  @default(true)
  limits    Json?
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, moduleKey])
  @@index([moduleKey])
}

// ============================================
// APPOINTMENTS
// ============================================

model Appointment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  psychologistId String
  psychologist   User       @relation("LegacyAppointmentPsychologist", fields: [psychologistId], references: [id], onDelete: Restrict)
  professionalId String?
  professional   User?      @relation("AppointmentProfessional", fields: [professionalId], references: [id], onDelete: Restrict)
  specialtyId    String?
  specialty      Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  branchId       String?
  branch         Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)

  title       String  @default("Consulta")
  description String?

  startTime DateTime
  endTime   DateTime
  duration  Int // minutes

  status AppointmentStatus @default(SCHEDULED)

  // Reminders tracking
  reminderSent24h    Boolean   @default(false)
  reminderSent2h     Boolean   @default(false)
  lastReminderSentAt DateTime?

  // Location/mode
  location   String? // e.g., "Consultorio 1", "Online - Zoom"
  isOnline   Boolean @default(false)
  meetingUrl String?

  // Cancellation
  cancelledAt        DateTime?
  cancelledBy        String? // userId
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  clinicalNotes     ClinicalNote[]
  specialtyRecords  SpecialtyRecord[]
  encounter         Encounter?
  treatmentSessions TreatmentSession[]

  @@index([tenantId])
  @@index([patientId])
  @@index([psychologistId])
  @@index([professionalId])
  @@index([startTime])
  @@index([status])
  @@index([tenantId, psychologistId, startTime])
  @@index([tenantId, professionalId, startTime])
  @@index([tenantId, patientId, professionalId, startTime])
}

// ============================================
// CLINICAL RECORDS
// ============================================

model ClinicalNote {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  psychologistId String
  psychologist   User       @relation(fields: [psychologistId], references: [id], onDelete: Restrict)
  specialtyId    String?
  specialty      Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  // The encounter the note was written in, when the professional opened one.
  encounterId    String?
  encounter      Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  // Content - can be encrypted at rest
  content      String // Clinical session notes
  diagnosis    String?
  treatment    String?
  observations String?

  // Metadata
  sessionDate     DateTime @default(now())
  sessionDuration Int? // minutes

  // Clinical records are never removed physically: corrections bump the version, removals set deletedAt.
  version        Int       @default(1)
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([patientId])
  @@index([psychologistId])
  @@index([appointmentId])
  @@index([encounterId])
  @@index([sessionDate])
}

// ============================================
// TASKS
// ============================================

model Task {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  title       String
  description String?

  status   TaskStatus   @default(PENDING)
  priority TaskPriority @default(MEDIUM)

  dueDate     DateTime?
  completedAt DateTime?

  createdById String
  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([patientId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
}

// ============================================
// NEXT SESSION PLAN
// ============================================

model NextSessionPlan {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  patientId String  @unique
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  psychologistId String
  psychologist   User       @relation(fields: [psychologistId], references: [id], onDelete: Restrict)
  specialtyId    String?
  specialty      Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)

  // Plan content
  objectives String? // Goals for next session
  techniques String? // Techniques to apply
  homework   String? // Homework for patient
  notes      String? // Additional notes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([patientId])
  @@index([psychologistId])
}

// ============================================
// NOTIFICATIONS
// ============================================

model NotificationLog {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  type   NotificationType
  status NotificationStatus @default(PENDING)

  title String
  body  String
  data  Json? // Custom payload for frontend

  // FCM specific
  fcmToken     String?
  fcmMessageId String?

  // Delivery tracking
  sentAt       DateTime?
  readAt       DateTime?
  failedAt     DateTime?
  errorMessage String?

  // Reference to related entity
  relatedEntityType String? // e.g., "appointment", "task"
  relatedEntityId   String?

  // Set for notifications that must exist at most once (a task falling due, a daily digest).
  dedupeKey String?

  createdAt DateTime @default(now())

  @@unique([tenantId, dedupeKey])
  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

// What each user wants to be notified about. A missing row means the defaults below.
model NotificationPreference {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pushEnabled          Boolean @default(true) // false keeps notifications in-app only
  appointmentReminders Boolean @default(true)
  taskDueReminders     Boolean @default(true)
  morningDigest        Boolean @default(false)

  updatedAt DateTime @updatedAt
}

// A browser subscribed to Web Push (RFC 8030). One user can have several.
model PushSubscription {
  id       String @id @default(cuid())
  tenantId String
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String  @unique
  p256dh    String
  auth      String
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action   AuditAction
  entity   AuditEntity
  entityId String

  // Patient the clinical record belongs to; null for non-clinical entities.
  patientId String?

  // Details
  changes   Json? // { before, after } snapshots
  reason    String? // Required for clinical corrections and removals
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ============================================
// TREATMENT SESSIONS
// ============================================

// A procedure the clinic offers. Price, duration and requirements live in its versions.
model Treatment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  category    String?
  // Null: any professional of the tenant can open sessions. Set: only that specialty.
  specialtyId String?
  specialty   Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)

  isActive       Boolean @default(true)
  currentVersion Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions TreatmentVersion[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

// An immutable snapshot of a treatment's price and requirements: sessions pin the version they
// were opened with.
model TreatmentVersion {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  treatmentId String
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  version     Int

  price           Decimal @db.Decimal(10, 2)
  taxRatePercent  Decimal @db.Decimal(5, 2)
  durationMinutes Int

  formDefinitionId String?
  formDefinition   FormDefinition? @relation(fields: [formDefinitionId], references: [id], onDelete: Restrict)
  formVersion      Int?

  consentTemplateVersionId String?
  consentTemplateVersion   ConsentTemplateVersion? @relation(fields: [consentTemplateVersionId], references: [id], onDelete: Restrict)

  // Validated by the server: medical form, informed consent, photos and clinical notes.
  requirements Json

  createdById String
  createdAt   DateTime @default(now())

  sessions TreatmentSession[]

  @@unique([treatmentId, version])
  @@index([tenantId])
}

// A consent text of the clinic. The text itself lives in its versions.
model ConsentTemplate {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name           String
  isActive       Boolean @default(true)
  currentVersion Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions ConsentTemplateVersion[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

// One text of a consent template. Once published or retired it is never edited.
model ConsentTemplateVersion {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  templateId String
  template   ConsentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version    Int

  title    String
  body     String
  // SHA-256 hex of `title + "\n" + body`.
  checksum String

  status      ConsentTemplateVersionStatus @default(DRAFT)
  publishedAt DateTime?
  retiredAt   DateTime?
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents         ConsentDocument[]
  treatmentVersions TreatmentVersion[]

  @@unique([templateId, version])
  @@index([tenantId])
}

// The consent text as the patient saw it in a session. The session it was presented in and the
// session it applies to can differ: a signed consent can be reused while it is valid.
model ConsentDocument {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  treatmentSessionId String
  treatmentSession   TreatmentSession @relation("ConsentDocumentPresentedIn", fields: [treatmentSessionId], references: [id], onDelete: Cascade)

  templateVersionId String
  templateVersion   ConsentTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)

  // Stored encrypted: the resolved text the patient saw.
  title    String
  body     String
  // SHA-256 hex of the resolved title and body, in the clear.
  checksum String

  status      ConsentDocumentStatus @default(PRESENTED)
  presentedAt DateTime              @default(now())
  signedAt    DateTime?
  refusedAt   DateTime?
  revokedAt   DateTime?

  // The PDF generated on signing, encrypted in the file storage.
  pdfStorageKey String?
  pdfChecksum   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signature       ConsentSignature?
  events          ConsentEvent[]
  appliedSessions TreatmentSession[] @relation("TreatmentSessionApplicableConsent")

  @@index([tenantId, patientId, createdAt])
  @@index([treatmentSessionId])
  @@index([templateVersionId])
}

// The evidence of a signed consent. One per signed document.
model ConsentSignature {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  documentId String          @unique
  document   ConsentDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  signerRole           ConsentSignerRole
  // Stored encrypted.
  signerName           String
  signerIdentification String
  // Required when the signer is a representative.
  relationship         String?

  understood        Boolean
  questionsAnswered Boolean
  // A separate authorization to use the photos in advertising.
  marketingPhotos   Boolean @default(false)

  // The signature drawing as a PNG, encrypted in the file storage.
  signatureStorageKey String

  operatorId String
  operator   User     @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  ipAddress  String?
  userAgent  String?
  signedAt   DateTime

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([operatorId])
}

// An entry of the history of a consent document. Insert only.
model ConsentEvent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  documentId String
  document   ConsentDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  type   ConsentEventType
  // Stored encrypted. Required for a refusal and a revocation.
  reason String?

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([documentId])
  @@index([actorId])
}

// One application of a treatment to a patient, from intake to clinical completion. Its status
// only changes through commands.
model TreatmentSession {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professionalId String
  professional   User         @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  // The version of the treatment the session was opened with.
  treatmentVersionId String
  treatmentVersion   TreatmentVersion @relation(fields: [treatmentVersionId], references: [id], onDelete: Restrict)

  // The PROCEDURE encounter that opens the session.
  encounterId String    @unique
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  // The answers to the medical form the treatment requires.
  formRecordId String?          @unique
  formRecord   SpecialtyRecord? @relation(fields: [formRecordId], references: [id], onDelete: Restrict)

  // The consent that applies: presented in this session or reused from an earlier one.
  consentDocumentId String?
  consentDocument   ConsentDocument? @relation("TreatmentSessionApplicableConsent", fields: [consentDocumentId], references: [id], onDelete: Restrict)

  status TreatmentSessionStatus @default(INTAKE_IN_PROGRESS)

  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  // Stored encrypted.
  procedureNotes     String?
  cancellationReason String?

  // Optimistic concurrency: every transition increments it.
  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  presentedConsents ConsentDocument[] @relation("ConsentDocumentPresentedIn")
  files             PatientFile[]
  orderItems        OrderItem[]

  @@index([tenantId, patientId, createdAt])
}

enum BillingProfileKind {
  PERSON
  COMPANY
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum OrderStatus {
  OPEN
  PAID
  INVOICED
  CANCELLED
}

enum OrderItemKind {
  TREATMENT_SESSION
  FREE
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  TRANSFER
  OTHER
}

enum PaymentStatus {
  RECORDED
  REFUNDED
}

// Who receives an invoice. Fiscal data, not clinical: it is not encrypted and has no relation
// to encounters, notes or files. Creating one never creates a patient.
model BillingProfile {
  invoiceRequests InvoiceRequest[]

  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  kind      BillingProfileKind
  // SRI identification type code: 04 RUC, 05 cedula, 06 passport, 07 final consumer.
  idType    String
  idNumber  String
  legalName String
  email     String?
  address   String?
  phone     String?
  isActive  Boolean            @default(true)

  createdById String
  createdBy   User     @relation("BillingProfileCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patients PatientBillingProfile[]
  orders   Order[]

  @@unique([tenantId, idType, idNumber])
  @@index([tenantId, legalName])
}

// A billing profile linked to a patient. At most one link per patient is the default (partial
// unique index in the migration).
model PatientBillingProfile {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  patientId        String
  patient          Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  billingProfileId String
  billingProfile   BillingProfile @relation(fields: [billingProfileId], references: [id], onDelete: Cascade)

  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([patientId, billingProfileId])
  @@index([tenantId])
}

// A cash drawer turn at one branch. At most one is OPEN per branch (partial unique index in the
// migration).
model CashRegisterSession {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  status   CashRegisterStatus @default(OPEN)

  openedById  String
  openedBy    User     @relation("CashRegisterOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  openedAt    DateTime @default(now())
  openingCash Decimal  @db.Decimal(10, 2)

  closedById String?
  closedBy   User?     @relation("CashRegisterClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  closedAt   DateTime?

  // Count taken when closing, computed by the server.
  expectedCash Decimal? @db.Decimal(10, 2)
  countedCash  Decimal? @db.Decimal(10, 2)
  difference   Decimal? @db.Decimal(10, 2)
  closingNote  String?

  payments         Payment[] @relation("PaymentCashRegister")
  refundedPayments Payment[] @relation("PaymentRefundCashRegister")

  @@index([tenantId, branchId, status])
}

// A charge to one billing profile, made of treatment sessions and free items.
model Order {
  invoiceRequests InvoiceRequest[]

  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  // Sequential per tenant.
  number   Int
  status   OrderStatus @default(OPEN)

  billingProfileId String?
  billingProfile   BillingProfile? @relation(fields: [billingProfileId], references: [id], onDelete: Restrict)

  // Computed by the server.
  subtotal      Decimal @default(0) @db.Decimal(10, 2)
  discountTotal Decimal @default(0) @db.Decimal(10, 2)
  taxTotal      Decimal @default(0) @db.Decimal(10, 2)
  total         Decimal @default(0) @db.Decimal(10, 2)
  paidTotal     Decimal @default(0) @db.Decimal(10, 2)

  createdById        String
  createdBy          User      @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledById      String?
  cancelledBy        User?     @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelledAt        DateTime?
  cancellationReason String?

  // Optimistic concurrency: every write increments it.
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, branchId, status])
  @@index([tenantId, createdAt])
}

model OrderItem {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  orderId String
  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind    OrderItemKind

  // A session is in one live order at a time (partial unique index in the migration).
  treatmentSessionId String?
  treatmentSession   TreatmentSession? @relation(fields: [treatmentSessionId], references: [id], onDelete: Restrict)
  patientId          String?
  patient            Patient?          @relation(fields: [patientId], references: [id], onDelete: Restrict)

  description    String
  quantity       Decimal @db.Decimal(12, 6)
  unitPrice      Decimal @db.Decimal(10, 2)
  discount       Decimal @default(0) @db.Decimal(10, 2)
  taxRatePercent Decimal @db.Decimal(5, 2)
  lineSubtotal   Decimal @db.Decimal(10, 2)
  lineTax        Decimal @db.Decimal(10, 2)

  // Set when the order is cancelled: the item no longer holds its session.
  releasedAt DateTime?

  createdById String
  createdBy   User     @relation("OrderItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([treatmentSessionId])
  @@index([patientId])
}

model Payment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  orderId               String
  order                 Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  cashRegisterSessionId String
  cashRegisterSession   CashRegisterSession @relation("PaymentCashRegister", fields: [cashRegisterSessionId], references: [id], onDelete: Restrict)

  method         PaymentMethod
  amount         Decimal       @db.Decimal(10, 2)
  reference      String?
  status         PaymentStatus @default(RECORDED)
  idempotencyKey String?

  receivedById String
  receivedBy   User     @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  receivedAt   DateTime @default(now())

  refundedById                String?
  refundedBy                  User?                @relation("PaymentRefundedBy", fields: [refundedById], references: [id], onDelete: Restrict)
  refundedAt                  DateTime?
  refundReason                String?
  refundCashRegisterSessionId String?
  refundCashRegisterSession   CashRegisterSession? @relation("PaymentRefundCashRegister", fields: [refundCashRegisterSessionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([orderId])
  @@index([cashRegisterSessionId])
  @@index([refundCashRegisterSessionId])
}

enum InvoiceRequestStatus {
  REQUESTED
  PROCESSING
  AUTHORIZED
  REJECTED
  FAILED
}

model InvoicingConnection {
  id                     String                @id @default(cuid())
  tenantId               String                @unique
  tenant                 Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  apiKeyEncrypted        String
  webhookSecretEncrypted String?
  externalTenantId       String
  taxpayerId             String
  taxpayerName           String
  taxpayerRuc            String
  environment            String
  active                 Boolean               @default(true)
  revision               Int                   @default(1)
  validatedAt            DateTime
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  points                 BranchEmissionPoint[]
  refs                   InvoicingRef[]
  requests               InvoiceRequest[]
  events                 InvoiceRequestEvent[]
}

model BranchEmissionPoint {
  id                String              @id @default(cuid())
  branchId          String              @unique
  branch            Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  connectionId      String
  connection        InvoicingConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  establishmentId   String
  emissionPointId   String
  establishmentCode String
  emissionPointCode String
  updatedAt         DateTime            @updatedAt

  @@index([connectionId])
}

model InvoicingRef {
  id           String              @id @default(cuid())
  connectionId String
  connection   InvoicingConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  kind         String
  localId      String
  externalId   String
  syncedHash   String
  updatedAt    DateTime            @updatedAt

  @@unique([connectionId, kind, localId])
}

model InvoiceRequest {
  id                       String                @id @default(cuid())
  tenantId                 String
  tenant                   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orderId                  String
  order                    Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  connectionId             String
  connection               InvoicingConnection   @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  billingProfileId         String
  billingProfile           BillingProfile        @relation(fields: [billingProfileId], references: [id], onDelete: Restrict)
  requestedById            String
  requestedBy              User                  @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  status                   InvoiceRequestStatus  @default(REQUESTED)
  clientIdempotencyKey     String
  providerIdempotencyKey   String                @unique
  snapshotEncrypted        String
  providerBodyEncrypted    String?
  providerBodyHash         String?
  requiresReconciliation   Boolean               @default(false)
  replacesInvoiceRequestId String?               @unique
  replacesInvoiceRequest   InvoiceRequest?       @relation("InvoiceReplacement", fields: [replacesInvoiceRequestId], references: [id], onDelete: Restrict)
  replacedBy               InvoiceRequest?       @relation("InvoiceReplacement")
  rootRequestId            String
  externalDocumentId       String?
  externalState            String?
  number                   String?
  accessKey                String?
  authorizationNumber      String?
  authorizedAt             DateTime?
  xmlStorageKey            String?
  xmlSha256                String?
  rideStorageKey           String?
  rideSha256               String?
  attempts                 Int                   @default(0)
  nextAttemptAt            DateTime              @default(now())
  lastErrorEncrypted       String?
  leaseToken               String?
  leaseUntil               DateTime?
  requestedAt              DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  finishedAt               DateTime?
  events                   InvoiceRequestEvent[]

  @@unique([tenantId, clientIdempotencyKey])
  @@unique([connectionId, externalDocumentId])
  @@index([tenantId, requestedAt])
  @@index([status, nextAttemptAt, leaseUntil])
  @@index([orderId])
  @@index([rootRequestId])
}

model InvoiceRequestEvent {
  id               String              @id @default(cuid())
  connectionId     String
  connection       InvoicingConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  invoiceRequestId String?
  invoiceRequest   InvoiceRequest?     @relation(fields: [invoiceRequestId], references: [id], onDelete: Restrict)
  type             String
  source           String
  detail           Json
  webhookEventId   String?
  createdAt        DateTime            @default(now())

  @@unique([connectionId, webhookEventId])
  @@index([invoiceRequestId, createdAt])
}
